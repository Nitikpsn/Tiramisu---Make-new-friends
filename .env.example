# Vite exposes only variables prefixed with VITE_ to browser code.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-browser-safe-publishable-or-anon-key
# Legacy alias supported for existing deployments.
VITE_SUPABASE_ANON_KEY=your-browser-safe-publishable-or-anon-key
